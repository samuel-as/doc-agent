# Recorder dependencies (end users install nothing)
node_modules/

# Node runtime downloaded by the bootstrap on first run
runtime/

# Local artifacts of each recording: they may contain internal screens
sessions/
browser-profile/

# Generated documentation stays on the machine that recorded it.
# Exception: this project's own specs and plans, under docs/superpowers/.
docs/*
!docs/superpowers/

# Temporary HTML from the PDF export (removed in the finally; left behind if the process dies)
.doc-agent-print.html

# Local Claude Code configuration (per-machine permissions)
.claude/settings.local.json

# Local state of the Superpowers workflow
.superpowers/

# Logs and OS/editor noise
*.log
npm-debug.log*
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
