# Recorder dev dependencies (end users install nothing)
node_modules/

# Recordings and docs generated when running /document inside THIS repo (dogfooding).
# In users' projects the same docs/<slug> layout is created and versioning it is their call.
# Exception: this project's own specs and plans, under docs/superpowers/.
docs/*
!docs/superpowers/

# Temporary HTML from the PDF export (removed in the finally; left behind if the process dies)
.doc-agent-print.html

# Local Claude Code configuration (per-machine permissions)
.claude/settings.local.json

# Local state of the Superpowers workflow
.superpowers/

# Logs and OS/editor noise
*.log
npm-debug.log*
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
